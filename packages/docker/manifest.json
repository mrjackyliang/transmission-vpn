{
  "build": {
    "enabled": false
  },
  "compose": {
    "capAdd": [
      "NET_ADMIN"
    ],
    "devices": [
      "/dev/net/tun:/dev/net/tun"
    ],
    "name": "transmission-vpn",
    "networks": {
      "default": {
        "enable_ipv6": true
      }
    },
    "ports": [
      "22602:22602",
      "22605:22605",
      "9091:9091"
    ],
    "restart": "unless-stopped",
    "volumes": [
      {
        "source": "config",
        "target": "/config"
      },
      {
        "source": "data",
        "target": "/data"
      }
    ]
  },
  "dockerfile": {
    "layout": "spaced",
    "stages": [
      {
        "before": "s6-overlay",
        "file": "stages/debian-base.Dockerfile",
        "name": "debian-base"
      },
      {
        "file": "stages/transmission-release.Dockerfile",
        "name": "transmission-release"
      },
      {
        "file": "stages/transmission-build.Dockerfile",
        "name": "transmission-build"
      },
      {
        "file": "stages/web-interface-build.Dockerfile",
        "name": "web-interface-build"
      },
      {
        "file": "stages/control-api-dependencies.Dockerfile",
        "name": "control-api-dependencies"
      },
      {
        "file": "stages/control-api-test.Dockerfile",
        "name": "control-api-test"
      },
      {
        "file": "stages/control-api-build.Dockerfile",
        "name": "control-api-build"
      }
    ]
  },
  "healthPath": "/api/v1/health/live",
  "healthService": "control-api",
  "legacyStatePaths": [],
  "networkMode": "bridge",
  "project": {
    "executables": [
      {
        "name": "*.sh",
        "path": "/usr/local/libexec/transmission-vpn"
      }
    ]
  },
  "runtime": {
    "copies": [
      {
        "beforeRootfs": true,
        "destination": "/usr/local/bin/transmission-daemon",
        "from": "transmission-build",
        "source": "/build/install/usr/local/bin/transmission-daemon"
      },
      {
        "beforeRootfs": true,
        "destination": "/usr/local/bin/transmission-vpn-api",
        "from": "control-api-build",
        "source": "/out/transmission-vpn-api"
      },
      {
        "beforeRootfs": true,
        "destination": "/usr/local/bin/transmission-vpn-directory-controller",
        "from": "control-api-build",
        "source": "/out/transmission-vpn-directory-controller"
      },
      {
        "beforeRootfs": true,
        "destination": "/usr/local/bin/transmission-vpn-transmission-runner",
        "from": "control-api-build",
        "source": "/out/transmission-vpn-transmission-runner"
      },
      {
        "beforeRootfs": true,
        "destination": "/usr/local/bin/transmission-vpn-vpn-controller",
        "from": "control-api-build",
        "source": "/out/transmission-vpn-vpn-controller"
      },
      {
        "beforeRootfs": true,
        "destination": "/usr/local/bin/transmission-vpn-web-proxy",
        "from": "control-api-build",
        "source": "/out/transmission-vpn-web-proxy"
      },
      {
        "beforeRootfs": true,
        "destination": "/usr/local/share/transmission-vpn/web",
        "from": "web-interface-build",
        "source": "/workspace/apps/transmission/build"
      }
    ],
    "expose": [
      9091
    ],
    "from": "debian-base",
    "packages": [
      "bash",
      "iproute2",
      "iptables",
      "libb64-0d",
      "libcurl4t64",
      "libdeflate0",
      "libevent-2.1-7t64",
      "libminiupnpc18",
      "libnatpmp1t64",
      "libstdc++6",
      "netcat-openbsd",
      "openvpn",
      "sysvinit-utils",
      "wget",
      "wireguard-go",
      "wireguard-tools"
    ]
  },
  "s6Overlay": {
    "from": "debian-base"
  },
  "schemaVersion": 2,
  "services": [
    {
      "command": "/usr/local/libexec/transmission-vpn/config-init.sh",
      "critical": false,
      "dependencies": [],
      "environment": {},
      "kind": "oneshot",
      "name": "config-init",
      "requiredForHealth": true,
      "runAsRoot": true,
      "workspace": "apps/transmission",
      "writablePaths": []
    },
    {
      "command": "/usr/local/bin/transmission-vpn-api",
      "critical": true,
      "dependencies": [
        "config-init",
        "directory-controller"
      ],
      "environment": {},
      "finishCommand": "/usr/local/libexec/transmission-vpn/foundation-service-finish.sh control-api",
      "kind": "longrun",
      "name": "control-api",
      "port": 22602,
      "requiredForHealth": true,
      "runAsRoot": false,
      "workspace": "apps/transmission",
      "writablePaths": []
    },
    {
      "command": "/usr/local/bin/transmission-vpn-directory-controller",
      "critical": true,
      "dependencies": [
        "config-init"
      ],
      "environment": {},
      "finishCommand": "/usr/local/libexec/transmission-vpn/foundation-service-finish.sh directory-controller",
      "kind": "longrun",
      "name": "directory-controller",
      "requiredForHealth": true,
      "runAsRoot": false,
      "workspace": "apps/transmission",
      "writablePaths": [
        "/data"
      ]
    },
    {
      "command": "/usr/local/libexec/transmission-vpn/firewall-init.sh",
      "critical": false,
      "dependencies": [
        "config-init"
      ],
      "down": "/usr/local/libexec/transmission-vpn/firewall-down.sh",
      "environment": {},
      "kind": "oneshot",
      "name": "firewall-init",
      "requiredForHealth": true,
      "runAsRoot": true,
      "workspace": "apps/transmission",
      "writablePaths": []
    },
    {
      "command": "/usr/local/bin/transmission-vpn-transmission-runner",
      "critical": true,
      "dependencies": [
        "firewall-init"
      ],
      "environment": {},
      "finishCommand": "/usr/local/libexec/transmission-vpn/foundation-service-finish.sh transmission",
      "kind": "longrun",
      "name": "transmission",
      "requiredForHealth": true,
      "runAsRoot": false,
      "workspace": "apps/transmission",
      "writablePaths": [
        "/data"
      ]
    },
    {
      "command": "/usr/local/bin/transmission-vpn-vpn-controller",
      "critical": false,
      "dependencies": [
        "firewall-init"
      ],
      "environment": {},
      "finishCommand": "/usr/local/libexec/transmission-vpn/foundation-service-finish.sh vpn-controller",
      "kind": "longrun",
      "name": "vpn-controller",
      "requiredForHealth": true,
      "runAsRoot": true,
      "workspace": "apps/transmission",
      "writablePaths": []
    },
    {
      "command": "/usr/local/bin/transmission-vpn-web-proxy",
      "critical": true,
      "dependencies": [
        "firewall-init"
      ],
      "environment": {},
      "finishCommand": "/usr/local/libexec/transmission-vpn/foundation-service-finish.sh web-proxy",
      "kind": "longrun",
      "name": "web-proxy",
      "port": 22605,
      "requiredForHealth": true,
      "runAsRoot": false,
      "workspace": "apps/transmission",
      "writablePaths": []
    }
  ],
  "stateEnvironment": "TRANSMISSION_VPN_STATE_DIRECTORY",
  "workspaces": [
    {
      "packageName": "transmission-vpn-app-transmission",
      "path": "apps/transmission",
      "profile": "container-native",
      "runtimePaths": []
    }
  ]
}
